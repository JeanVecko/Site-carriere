PORT=10000

# Neon : copier la chaîne "Pooled connection" depuis le tableau de bord Neon.
# Conserver sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@carrieresrdc.cd
ADMIN_PASSWORD=replace-with-a-strong-password

# URLs publiques (utilisées dans les liens envoyés par e-mail)
FRONTEND_URL=https://your-vercel-project.vercel.app
API_PUBLIC_URL=https://carrieres-rdc-api.onrender.com

# Adresse qui reçoit une alerte à chaque message du formulaire de contact (défaut : ADMIN_EMAIL)
CONTACT_ALERT_EMAIL=

# E-mails, option 1 : SMTP (Gmail par défaut, avec un mot de passe d'application)
EMAIL_FROM_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Carrières RDC
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# E-mails, option 2 : Resend (utilisé si l'option SMTP n'est pas configurée)
RESEND_API_KEY=
EMAIL_FROM=Carrières RDC <noreply@example.com>
